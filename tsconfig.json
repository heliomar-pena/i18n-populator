{
  "compilerOptions": {
    "moduleDetection": "force",
    "module": "Preserve",
    "resolveJsonModule": true,
    "allowJs": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "target": "es2020",
    "strict": true
  },
  "exclude": [
    "dist/*",
    "node_modules/**/*",
    "eslint.config.mjs",
    "jest.config.js"
  ]
}
