{
  "name": "i18n-populator",
  "version": "2.0.1",
  "description": "Generate translations in seconds for i18n",
  "type": "module",
  "scripts": {
    "type-check": "tsc  --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "prepare": "husky",
    "build": "pkgroll --clean-dist"
  },
  "bin": "./dist/cli.cjs",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">16"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "i18n",
    "tools",
    "save-time",
    "cli",
    "cli-app",
    "cli-tool",
    "development-tool"
  ],
  "author": {
    "name": "Heliomar Peña",
    "email": "penaheliomar@gmail.com",
    "url": "https://www.linkedin.com/in/heliomar/"
  },
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.3.1",
    "@vitalets/google-translate-api": "^9.2.0",
    "bing-translate-api": "^4.0.0",
    "commander": "^13.1.0",
    "dset": "^3.1.4",
    "node-fetch": "^2.7.0",
    "prompt-sync-plus": "^1.0.2"
  },
  "homepage": "https://github.com/heliomar-pena/i18n-populator#readme",
  "bugs": {
    "url": "https://github.com/heliomar-pena/i18n-populator/issues/new",
    "email": "penaheliomar@gmail.com"
  },
  "devDependencies": {
    "@eslint/js": "^9.4.0",
    "@jest/globals": "^29.7.0",
    "@types/node": "^22.13.1",
    "@types/node-fetch": "^2.6.12",
    "eslint": "^9.4.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.3.0",
    "husky": "^9.0.11",
    "jest": "^29.6.4",
    "pkgroll": "^2.8.0",
    "prettier": "3.3.1",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
